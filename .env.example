DB_HOST=localhost
DB_PORT=5432
DB_NAME=shadow_it_db
DB_USER=postgres
DB_PASSWORD=<set-a-strong-password>
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRY_HOURS=8

# Concurrent-session (identity Shadow IT) detection. Flag when one account is
# active from more than N distinct IPs at once; ENFORCE revokes the oldest
# sessions until the count is back within the limit.
CONCURRENT_SESSION_MAX_IPS=2
CONCURRENT_SESSION_ENFORCE=true

# AI Assistant (read-only LLM over the detections DB). Requires an Anthropic
# API key from console.anthropic.com. Without it, /api/assistant/ask returns 503.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ASSISTANT_MODEL=claude-sonnet-5

# Wazuh software-inventory ingest (POST /api/wazuh/sync). Flags installed
# software matching ml/saas_catalog.csv by app name (e.g. TeamViewer, AnyDesk,
# Dropbox) via Syscollector, independent of network capture. Defaults match
# the manager-only Docker deployment on the bank-net docker-host VM.
WAZUH_API_URL=https://192.168.137.40:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# Auto-suggested firewall rules (POST /api/firewall/rules/generate, PATCH
# .../rules/<id>). Approval actually executes the suggested command against
# the real target — SSH to docker-host (uses your own trusted SSH key, only
# the sudo/ufw password is stored here) or vmrun guest-ops to Windows VMs.
# Extend ml/enforcement.py's KNOWN_HOSTS if your topology differs.
FIREWALL_SSH_USER=server
FIREWALL_DOCKER_HOST_IP=192.168.137.40
FIREWALL_SSH_SUDO_PASSWORD=<sudo-password-on-docker-host>
VMRUN_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe
FIREWALL_SUPPORT_WS_VMX=<path-to-support-ws.vmx>
FIREWALL_SUPPORT_WS_USER=<hostname>\<username>
FIREWALL_SUPPORT_WS_PASS=<password>
FIREWALL_EMPLOYEE_WS_VMX=<path-to-employee-ws.vmx>
FIREWALL_EMPLOYEE_WS_USER=<hostname>\<username>
FIREWALL_EMPLOYEE_WS_PASS=<password>

# Cookie / transport hardening
# COOKIE_SECURE=true once served over HTTPS (see deploy/ TLS proxy).
# Leave false for plain http://localhost or browsers may drop the cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Flask dev server only. NEVER set FLASK_DEBUG=true on an exposed host —
# the Werkzeug debugger is remote code execution. Production uses gunicorn.
FLASK_DEBUG=false
FLASK_PORT=5000
