# bank-net macvlan parameters — copy to .env and edit for YOUR LAN.
# Used by docker-compose.yml INSIDE the Ubuntu Server VM (the Docker host).
#
#   cp .env.example .env
#
# Find the Ubuntu VM's LAN NIC + subnet:  ip -4 addr    (inside the Ubuntu VM)
# The container IPs below MUST be:
#   * inside the banking device's LAN /24 (the router's subnet), and
#   * OUTSIDE the router's DHCP pool (so nothing else claims them).
# Example assumes a 192.168.1.0/24 LAN with DHCP handing out .100-.199.

# The Ubuntu VM's BRIDGED vNIC (e.g. ens33) — the macvlan parent. Its VMware
# port must ALLOW promiscuous mode + MAC changes (see vms/README.md).
PARENT_NIC=ens33

# The router's subnet and gateway.
SUBNET=192.168.1.0/24
GATEWAY=192.168.1.1

# A slice of the subnet Docker may allocate from — keep it outside DHCP.
# Leave .243/.244 free for the support-ws / employee-ws Windows VMs (below).
IP_RANGE=192.168.1.240/28

# Static IP per CONTAINER (all inside IP_RANGE / outside DHCP).
IP_TELLER_01=192.168.1.241
IP_TELLER_02=192.168.1.242
IP_ROGUE_PI=192.168.1.245
IP_EXFIL_01=192.168.1.246

# The two Windows VMs are NOT managed by this compose — set these IPs INSIDE the
# guest OS (static), reserved here only so nothing collides:
#   support-ws  = 192.168.1.244   (real TeamViewer / AnyDesk)
#   employee-ws = 192.168.1.243   (real Dropbox / ChatGPT / personal mail)

# Exfil role: bulk-upload sink (a real transfer service so the flow leaves the
# host) and body size in MB. Use an operator-supplied endpoint if you prefer.
EXFIL_SINK=https://transfer.sh
EXFIL_MB=8
